# Variables pour les tests Vitest. Surclasse .env.
# Force la DB de test (sinon on pollue la DB dev).
DATABASE_URL=postgresql://shop:shop@127.0.0.1:5432/shop_test?schema=public
SESSION_SECRET=test-secret-not-for-prod
SESSION_COOKIE_NAME=admin_session
SESSION_TTL_HOURS=1
BCRYPT_ROUNDS=4
NODE_ENV=test
