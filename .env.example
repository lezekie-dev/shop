# ─── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
LOG_LEVEL=info

# ─── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://shop:shop@localhost:5432/shop?schema=public
DATABASE_URL_TEST=postgresql://shop:shop@localhost:5432/shop_test?schema=public

# ─── Auth admin ───────────────────────────────────────
SESSION_SECRET=dev-secret-change-me-in-prod
SESSION_COOKIE_NAME=admin_session
SESSION_TTL_HOURS=24
BCRYPT_ROUNDS=12

# ─── Déclencheur de cron (réconciliation des paiements) ───
# Secret partagé avec le planificateur du serveur (cron système ou planificateur
# Coolify) : la route POST /api/cron/reconcile-payments l'exige dans l'en-tête
# `x-cron-secret` (ou `Authorization: Bearer <secret>`). Laisser vide désactive
# la route (503) : elle ne s'exécute JAMAIS sans secret valide.
#   curl -X POST https://<boutique>/api/cron/reconcile-payments -H "x-cron-secret: $CRON_SECRET"
CRON_SECRET=

# ─── Payment provider (S3 : mock | mobile_money | bank_transfer | stripe) ───
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=sk_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_dummy

# ─── Virement bancaire (S3) ───────────────────────────
# OPTIONNEL : aucun compte tiers requis. Les valeurs ci-dessous sont des
# VALEURS DE DÉMONSTRATION (IBAN de test, banque fictive) — l'app tourne
# sans configuration. Remplacer par l'IBAN réel de la boutique pour
# encaisser de vrais virements.
BANK_TRANSFER_IBAN=FR76 3000 4000 0300 0000 0000 123
BANK_TRANSFER_HOLDER=Shop Démo SARL
BANK_TRANSFER_BANK_NAME=Banque de Démonstration

# ─── Emails transactionnels (S3) ──────────────────────
# outbox = l'email est écrit dans la table EmailOutbox : AUCUN compte ni SMTP
# requis (défaut). resend / smtp nécessitent RESEND_API_KEY / SMTP_URL et
# jetteront un message explicite tant que le transport n'est pas implémenté.
EMAIL_PROVIDER=outbox
EMAIL_FROM=no-reply@shop.local
SHOP_NAME=Shop Démo

# ─── Shipping (placeholder MVP) ───────────────────────
SHIPPING_FLAT_MINOR=590
FREE_SHIPPING_THRESHOLD_MINOR=5000
